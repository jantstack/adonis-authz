/**
 * La DDL del trigger de partición de `authz_relations` por dialecto. Es la
 * MISMA que `relationPartitionTrigger` del paquete
 * (`@jantstack/adonis-authz` → `src/drivers/database_relations_driver.ts`);
 * se inlinea aquí porque una migración es una foto congelada y no importa
 * código del paquete. Dialecto no medido ⇒ lanza (nunca una tabla sin defensa).
 */
function relationPartitionTriggerStatements(dialect) {
  const msg = 'authz_relations: un userset no puede pertenecer a otra partición que su tupla'
  if (dialect === 'sqlite3' || dialect === 'better-sqlite3') {
    const body = (event) =>
      `CREATE TRIGGER authz_relations_partition_b${event === 'INSERT' ? 'i' : 'u'} ` +
      `BEFORE ${event} ON authz_relations FOR EACH ROW ` +
      `WHEN NEW.subject_relation IS NOT NULL AND NEW.subject_partition IS NOT NEW.partition_key ` +
      `BEGIN SELECT RAISE(ABORT, '${msg}'); END`
    return [body('INSERT'), body('UPDATE')]
  }
  if (dialect === 'postgres') {
    return [
      `CREATE OR REPLACE FUNCTION authz_relations_partition_guard() RETURNS trigger LANGUAGE plpgsql AS $authz$ ` +
        `BEGIN ` +
        `IF NEW.subject_relation IS NOT NULL AND NEW.subject_partition IS DISTINCT FROM NEW.partition_key THEN ` +
        `RAISE EXCEPTION '${msg} (subject_partition=%, partition_key=%)', NEW.subject_partition, NEW.partition_key; ` +
        `END IF; RETURN NEW; END; $authz$`,
      `CREATE TRIGGER authz_relations_partition_biu BEFORE INSERT OR UPDATE ON authz_relations ` +
        `FOR EACH ROW EXECUTE FUNCTION authz_relations_partition_guard()`,
    ]
  }
  if (dialect === 'mysql' || dialect === 'mysql2') {
    const body = (event) =>
      `CREATE TRIGGER authz_relations_partition_b${event === 'INSERT' ? 'i' : 'u'} ` +
      `BEFORE ${event} ON authz_relations FOR EACH ROW ` +
      `BEGIN ` +
      `IF NEW.subject_relation IS NOT NULL AND NOT (NEW.subject_partition <=> NEW.partition_key) THEN ` +
      `SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = '${msg}'; ` +
      `END IF; END`
    return [body('INSERT'), body('UPDATE')]
  }
  throw new Error(
    `authz_relations: dialecto '${dialect}' sin trigger de partición medido (hoy: PostgreSQL, MySQL 8 y SQLite).`
  )
}
