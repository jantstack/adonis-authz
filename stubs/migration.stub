      table.uuid('uuid').primary().notNullable()
      // Formato `recurso:accion` (la misma gramática que las abilities M3).
      table.string('slug', 100).notNullable().unique().collate('utf8mb4_bin')
      table.string('description', 500).nullable()
      // Niveles (scope types) cuyos roles PUEDEN llevar este permiso (3B ·
      // B5): JSON `["app","organization"]`, o NULL = cualquiera. Control de
      // COMPOSICIÓN (sync, defineScopedRole, grant); jamás de evaluación.
      table.string('assignable_at', 500).nullable()
      table.timestamp('created_at').notNullable()
      table.timestamp('updated_at').notNullable()
