      table.string('description', 500).nullable()
      // Nivel al que el rol es asignable: 'app' | 'organization' | 'unit'.
      // Identidad: byte a byte, como el resto (2.5-B, auditor ⚪4).
      table.string('scope_type', 20).notNullable().collate('utf8mb4_bin')
      // Rango de privilegio (mayor = más poder). Lo consume la policy de
      // asignación (role_assignment_policy): nadie otorga/quita por encima
      // de su propio rango.
      table.integer('rank').notNullable().defaultTo(0)
      // Quién define el rol (3B · B1): `global` (el catálogo del config,
      // `syncAuthzCatalog`) o la clave del scope que lo define
      // (`<tipo>|<uuid>`, `defineScopedRole`). Un rol local solo existe
      // dentro de su owner; dos tenants pueden definir `lead@unit` cada uno.
      // Es identidad: byte a byte. `app` nunca es owner (sería global).
      table.string('owner_scope_key', 80).notNullable().defaultTo('global').collate('utf8mb4_bin')
      table.timestamp('created_at').notNullable()
      table.timestamp('updated_at').notNullable()

      table.unique(['slug', 'scope_type', 'owner_scope_key'], 'authz_roles_slug_scope_owner_uq')
      table.index(['owner_scope_key'], 'authz_roles_owner_idx')
