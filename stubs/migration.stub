  public async down() {
    this.defer(async (db) => {
      const drops =
        db.dialect.name === 'postgres'
          ? [
              'DROP TRIGGER IF EXISTS authz_relations_partition_biu ON authz_relations',
              'DROP FUNCTION IF EXISTS authz_relations_partition_guard()',
            ]
          : [
              'DROP TRIGGER IF EXISTS authz_relations_partition_bi',
              'DROP TRIGGER IF EXISTS authz_relations_partition_bu',
            ]
      for (const statement of drops) await db.rawQuery(statement)
    })
    this.schema.dropTable('authz_relations')
    this.schema.dropTable('authz_catalog_version')
    this.schema.dropTable('authz_denies')
    this.schema.dropTable('authz_assignments')
    this.schema.dropTable('authz_role_permissions')
    this.schema.dropTable('authz_permissions')
    this.schema.dropTable('authz_roles')
