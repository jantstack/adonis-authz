        .uuid('permission_uuid')
        .notNullable()
        .references('uuid')
        .inTable('authz_permissions')
        .onDelete('CASCADE')
      table.timestamp('created_at').notNullable()

      table.unique(['role_uuid', 'permission_uuid'], 'authz_role_perms_uq')
