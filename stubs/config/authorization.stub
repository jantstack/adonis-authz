{{{
  exports({ to: app.configPath('authorization.ts') })
}}}
import env from '#start/env'
import { defineConfig, DatabaseAuthorizationDriver, APP_SCOPE } from '@jantstack/adonis-authz'
import type { AuthzWriteEvent, ScopeRef } from '@jantstack/adonis-authz'
import { appAclCatalog } from '#config/app_acl'

/**
 * Holders de tu aplicación: morph name (`@MorphMap` del modelo) → tipo del
 * modelo FGA. Solo lo usa el driver `openfga` y sus comandos.
 *
 * ⚠️ Cambiar este mapa cambia el authorization model: hay que re-provisionar
 * el store (`node ace openfga:provision`) y volver a proyectar el catálogo.
 */
export const holderTypes = {
  users: 'user',
}

/**
 * Jerarquía de scopes de tu dominio: la ÚNICA costura entre tu dominio y el
 * motor. El motor solo conoce la raíz (`app`); si tienes niveles propios
 * (organizaciones, proyectos, sedes…), devuelve aquí la CADENA CANÓNICA del
 * scope: él mismo TAL COMO ESTÁ EN TU TABLA (la fila leída, no lo que llegó
 * en la pregunta) y después sus ancestros del más cercano a la raíz, con
 * `APP_SCOPE` al final; y `null` si el scope NO existe (el motor deniega y
 * rechaza escribir sobre él). Nunca devuelvas `[scope, APP_SCOPE]` para lo
 * que no conoces: convertiría cualquier scope inventado en descendiente de la
 * raíz. Devolver la fila (y no el argumento) es lo que impide que un alias del
 * uuid —mayúsculas, guiones quitados, que el tipo `uuid` de PostgreSQL o una
 * collation `*_ci` funden con la fila real— evada un deny escrito con la
 * forma canónica. `hierarchicalScopeResolver({ nodeOf })` lo hace por ti a
 * partir de un `nodeOf` que lea la fila.
 *
 *   organization → [la organization (fila), APP_SCOPE]                  (si existe; si no, null)
 *   unit         → [la unit (fila), su organization (fila), APP_SCOPE]  (idem)
 *
 * Esta MISMA función va a tres sitios, y tiene que ser la misma:
 *   - `scopes.resolveChain` (abajo): el manager valida con ella
 *     `scopes.attached/moved` (padre existente, sin ciclos) antes de tocar
 *     el driver;
 *   - `resolveChain` de cada driver: con ella responde `authorize`,
 *     `hasRole` y los `list*`, y valida `grant`/`deny`.
 *   Un driver sin ella solo conoce `app` (422 al preguntar por otro nivel).
 *
 * Cuando tu árbol cambie, avisa al motor en todos los drivers:
 *   authorization.scopes.attached(child, parent) / moved(child, newParent) /
 *   detached(child)  ← purga los hechos del scope antes de que borres la fila.
 */
async function resolveScopeChain(scope: ScopeRef): Promise<ScopeRef[] | null> {
  if (scope.type === 'app') return [APP_SCOPE]
  // TODO: consulta tu tabla; devuelve null si `scope.uuid` no existe, y si
  // existe, [{ type, uuid: fila.uuid }, ...ancestros, APP_SCOPE].
  return null
}

/**
 * Side-effects de cada escritura del motor (grant/revoke/deny). El sitio
 * natural para auditar. Debe ser best-effort: no lances desde aquí.
 */
async function onAuthzWrite(_event: AuthzWriteEvent) {}

export default defineConfig({
  default: env.get('AUTHZ_DRIVER', 'database'),

  holderTypes,

  openfga: {
    url: env.get('OPENFGA_URL'),
    storeId: env.get('OPENFGA_STORE_ID'),
    modelId: env.get('OPENFGA_MODEL_ID'),
  },

  // La costura del árbol (ver arriba): la misma función que reciben los drivers.
  // 2.1: añade `descendantsOf: sqlDescendantsOf({ table, uuidColumn, parentColumn, typeColumn })`
  // (2.2: con `descendantsOf`, `scopes.detached` purga también los roles
  //  locales del SUBÁRBOL —sin él, solo los del scope exacto— y el nivel de
  //  un rol local se comprueba contra el árbol de hoy; delegar hacia abajo
  //  —`lead@unit` con owner una org— funciona con o sin él)
  // (o tu propia función) para `authorizedScopes`; y `requireWithin: true` / `requireActor: true`
  // en cuanto todos los call-sites pasen `within` / `actor` (hasta entonces el manager avisa).
  // 2.3: `enumerateEdges: sqlScopeEdges({ table, uuidColumn, parentColumn, typeColumn })` es
  //  el árbol ENTERO paginado, y lo necesita `node ace authz:reconcile` (migrar entre drivers
  //  y verificar con --dry-run). Sin él el comando se niega en vez de suponer un árbol plano.
  //  La migración va en las DOS direcciones: `--to=openfga` reconstruye el store desde `authz_*`
  //  + este árbol, y `--to=database` reconstruye `authz_*` desde los hechos del store (ahí el
  //  árbol NO se migra: el driver `database` lo lee de TUS tablas en cada pregunta).
  scopes: {
    resolveChain: resolveScopeChain,
    // Con AUTHZ_DRIVER=openfga el árbol vive en DOS sitios (tus tablas y el
    // store) y quien ENCOLA los cambios es el MANAGER, que lee ESTA sección
    // —no las opciones del driver—: sin una de las dos mitigaciones aquí,
    // cada request es 500 E_AUTHZ_SCOPE_DRIFT_UNGUARDED. Igual que en la
    // factory de abajo: cámbialo por `outbox: scopeOutbox` (la MISMA
    // instancia en los dos sitios) en cuanto el árbol lo muevan peticiones
    // de tenant; hasta entonces, esta es la firma explícita del riesgo.
    // Con AUTHZ_DRIVER=database no aplica (el árbol tiene una sola copia).
    acceptScopeDriftRisk: true,
  },

  drivers: {
    database: () => new DatabaseAuthorizationDriver({ resolveChain: resolveScopeChain }),

    /**
     * Backend externo opcional. Levanta el servidor y provisiona con
     * `node ace openfga:provision` (escribe el modelo con TUS permisos: el
     * modelo cambia cada vez que añades o quitas uno, y `authz:catalog:sync`
     * proyecta el catálogo en el store).
     * El driver vive en el subpath `/openfga` (lo único que importa el peer
     * opcional `@openfga/sdk`) y se carga DENTRO de la factory: sin
     * AUTHZ_DRIVER=openfga el SDK ni se instala ni se importa.
     *
     * **El árbol de scopes vive en el store** (el driver es el PDP y
     * `authorize` es un solo `Check`), así que hay DOS copias del árbol —la
     * tuya y la suya— y un `rollback` de tu transacción dejaría la del store
     * adelantada. Por eso el driver NO se construye sin una de las dos
     * mitigaciones (500 `E_AUTHZ_SCOPE_DRIFT_UNGUARDED`):
     *
     *   - `scopes.outbox`: la MISMA instancia que pones en `scopes` arriba —
     *     el manager encola los cambios del árbol dentro de tu transacción y
     *     `node ace authz:scopes:relay` los aplica. Es la recomendada;
     *     publica la tabla con la migración `scopes_outbox_migration.stub`.
     *   - `acceptScopeDriftRisk: true`: la firma explícita de quien mueve el
     *     árbol solo desde la plataforma y lo asume.
     */
    openfga: async () => {
      const { OpenFgaAuthorizationDriver } = await import('@jantstack/adonis-authz/openfga')
      const apiUrl = env.get('OPENFGA_URL')
      const storeId = env.get('OPENFGA_STORE_ID')
      if (!apiUrl || !storeId) {
        throw new Error('AUTHZ_DRIVER=openfga requiere OPENFGA_URL y OPENFGA_STORE_ID')
      }
      return new OpenFgaAuthorizationDriver({
        apiUrl,
        storeId,
        modelId: env.get('OPENFGA_MODEL_ID'),
        resolveChain: resolveScopeChain,
        holderTypes,
        // Cámbialo por `outbox: scopeOutbox` (la misma que pases en `scopes`)
        // en cuanto el árbol lo muevan peticiones de tenant.
        acceptScopeDriftRisk: true,
      })
    },
  },

  /**
   * Catálogos de roles/permisos (uno por módulo). `node ace authz:catalog:sync`
   * los sincroniza en orden (podando los vínculos que el config ya no lista);
   * `node ace authz:catalog:diff` falla en CI si la base no coincide.
   */
  catalogs: [async () => appAclCatalog()],

  /**
   * Roles locales a un scope (2.2): `defineScopedRole(actor, ownerScope, spec)`
   * solo puede meter en un rol local permisos de esta lista blanca (y que el
   * actor tenga efectivos en el owner). Vacía = nadie delega nada. Los
   * permisos de plataforma (`admin:*`, ajustes de organización) no deberían
   * estar aquí.
   */
  delegablePermissions: [],

  hooks: { onWrite: onAuthzWrite },
})
